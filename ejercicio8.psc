Algoritmo ejercicio8
	Definir contadordenum, cantidadterminos, termino Como Entero
	Imprimir "Ingrese la cantidad de numeros a contar:"
	Leer cantidadterminos
	contadordenum = 0
	termino = 1
	Repetir
		Imprimir termino
		termino = termino + 2
		contadordenum = contadordenum + 1
	Mientras Que contadordenum < cantidadterminos - 1
	Imprimir (termino)
FinAlgoritmo
