Algoritmo ejercicio13
	Definir valorx, x, funcionn Como Entero
	Imprimir "Ingrese el maximo valor para x: "
	Repetir
		leer valorx
	Mientras Que valorx < 0 
	Para x = 0 Hasta valorx Con Paso 2
		funcionn = x^3 + x^2 - 5
		Imprimir "Para x = ", x, " f(x) =", funcionn
	FinPara
FinAlgoritmo
